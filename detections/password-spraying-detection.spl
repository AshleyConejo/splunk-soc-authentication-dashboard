index=windows_auth EventCode=4625
| eval user=coalesce(
    TargetUserName,
    mvindex(Account_Name,-1),
    user
)
| eval src_ip=coalesce(
    IpAddress,
    Source_Network_Address,
    src,
    "Local or unavailable"
)
| where isnotnull(user) AND user!="-"
| bin _time span=10m
| stats
    count as total_failures
    dc(user) as targeted_account_count
    values(user) as targeted_accounts
    values(host) as affected_hosts
    by _time src_ip
| where targeted_account_count>=5
| sort - targeted_account_count